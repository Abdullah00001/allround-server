# Copy to docker/.env on the VPS and fill real secrets.
# Used by: cd docker && docker compose up -d --build
# Do NOT commit docker/.env

# ==========================================
# Application Core
# ==========================================
NODE_ENV=production
PORT=5000
SERVER_URL=https://api.allround-geruestbau.de

# ==========================================
# Postgres (compose service hostname: postgres)
# ==========================================
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_STRONG_DB_PASSWORD
POSTGRES_DB=allround-server
DATABASE_URL=postgresql://postgres:CHANGE_ME_STRONG_DB_PASSWORD@postgres:5432/allround-server?schema=public

# ==========================================
# Redis (compose service hostname: redis)
# ==========================================
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=CHANGE_ME_STRONG_REDIS_PASSWORD
# false for compose Redis; true only for managed Redis that requires TLS
REDIS_TLS=false

# ==========================================
# SMTP
# ==========================================
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=

# ==========================================
# Firebase (worker push)
# ==========================================
FIREBASE_ACCOUNT_TYPE=service_account
FIREBASE_PROJECT_ID=
FIREBASE_PRIVATE_KEY_ID=
FIREBASE_PRIVATE_KEY=
FIREBASE_CLIENT_EMAIL=
FIREBASE_CLIENT_ID=
FIREBASE_AUTH_URI=https://accounts.google.com/o/oauth2/auth
FIREBASE_TOKEN_URI=https://oauth2.googleapis.com/token
FIREBASE_AUTH_PROVIDER_X509_CERT_URL=https://www.googleapis.com/oauth2/v1/certs
FIREBASE_CLIENT_X509_CERT_URL=
FIREBASE_UNIVERSE_DOMAIN=googleapis.com

# ==========================================
# JWT
# ==========================================
JWT_ACCESS_TOKEN_SECRET_KEY=
JWT_REFRESH_TOKEN_SECRET_KEY=
JWT_VERIFY_OTP_PAGE_SECRET_KEY=
JWT_RESET_PASSWORD_TOKEN_SECRET_KEY=

# ==========================================
# S3 / Spaces
# ==========================================
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_REGION=fra1
S3_BUCKET_NAME=
S3_ENDPOINT=https://fra1.digitaloceanspaces.com
S3_PUBLIC_URL=

# ==========================================
# Misc
# ==========================================
OTP_HASH_SECRET=
TRANSLATION_PROVIDER=google
GOOGLE_TRANSLATION_API_KEY=
